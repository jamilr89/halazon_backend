{
  "workspaces": [
    "apps/*"
  ],
  "name": "dtc-starter-monorepo",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "npm run seed --workspace=apps/backend",
    "backend:dev": "npm run dev --workspace=apps/backend",
    "storefront:dev": "npm run dev --workspace=apps/storefront",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "overrides": {
    "ajv": "^8.0.0",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
   "@medusajs/file-s3": {
  "@aws-sdk/client-s3": "3.726.1"
}
},
  "dependencies": {
    "@medusajs/ui": "4.1.15"
  }
}
